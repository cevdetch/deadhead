{
  "name": "deadhead",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Documentation-driven linter for HTML <head>: finds deprecated, unnecessary and harmful markup and explains why. One rule set, three runtimes (CLI, browser, ESLint).",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@12.6.0",
  "scripts": {
    "build": "node scripts/build-rules.ts",
    "build:css": "node scripts/build-css.ts",
    "build:bookmarklet": "node --disable-warning=ExperimentalWarning scripts/build-bookmarklet.ts",
    "build:packages": "pnpm build && node scripts/build-packages.ts",
    "bench": "node scripts/bench.ts",
    "test": "node scripts/build-rules.ts && node --test",
    "test:conformance": "node scripts/build-rules.ts && node --test test/conformance/",
    "check": "node packages/cli/bin/deadhead.ts",
    "check:self": "node packages/cli/bin/deadhead.ts \"test/fixtures/*/*/valid.html\"",
    "check:bookmarklet": "node scripts/check-bookmarklet-csp.ts",
    "check:packages": "pnpm build:packages && node scripts/check-packages.ts",
    "smoke:packages": "node scripts/smoke-packages.ts",
    "check:site": "pnpm site:build && node packages/cli/bin/deadhead.ts site/dist && node scripts/site-budget.ts site/dist && node scripts/site-seo.ts site/dist",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p packages/browser/tsconfig.json && tsc --noEmit -p test/conformance/tsconfig.json",
    "validate:rules": "node scripts/validate-rules.ts",
    "site:dev": "pnpm --filter @deadhead/site dev",
    "site:build": "pnpm build && pnpm build:css && pnpm build:bookmarklet && pnpm --filter @deadhead/site build",
    "site:preview": "pnpm --filter @deadhead/site preview",
    "site:check": "pnpm --filter @deadhead/site check",
    "lint:deps": "e18e-cli analyze --log-level error --report-level warn"
  },
  "devDependencies": {
    "@e18e/cli": "0.7.0",
    "@html-eslint/parser": "^0.66.1",
    "@types/node": "^24.0.0",
    "eslint": "^10.11.0",
    "linkedom": "^0.18.13",
    "parse5": "^8.0.1",
    "publint": "^0.3.24",
    "rolldown": "^1.2.9",
    "rolldown-plugin-dts": "0.28.6",
    "typescript": "^7.0.2",
    "yaml": "^2.9.0"
  },
  "keywords": [
    "html",
    "head",
    "linter",
    "meta-tags",
    "deprecated",
    "eslint-plugin",
    "bookmarklet",
    "static-analysis"
  ]
}
