{
  "name": "deadhead",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Documentation-driven linter for HTML <head>: finds deprecated, unnecessary and harmful markup and explains why. One rule set, three runtimes (CLI, browser, ESLint).",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "bun@1.4.5",
  "scripts": {
    "build": "bun scripts/build-rules.ts",
    "build:css": "bun scripts/build-css.ts",
    "build:bookmarklet": "bun scripts/build-bookmarklet.ts",
    "build:packages": "bun run build && bun scripts/build-packages.ts",
    "bench": "bun scripts/bench.ts",
    "test": "bun scripts/build-rules.ts && bun test",
    "test:conformance": "bun scripts/build-rules.ts && bun test test/conformance/",
    "check": "bun packages/cli/bin/deadhead.ts",
    "check:self": "bun packages/cli/bin/deadhead.ts \"test/fixtures/*/*/valid.html\"",
    "check:bookmarklet": "bun scripts/check-bookmarklet-csp.ts",
    "check:packages": "bun run build:packages && bun scripts/check-packages.ts",
    "smoke:packages": "bun scripts/smoke-packages.ts",
    "check:site": "bun run site:build && bun packages/cli/bin/deadhead.ts site/dist && bun scripts/site-budget.ts site/dist && bun scripts/site-seo.ts site/dist && bun scripts/site-crawlers.ts site/dist",
    "corpus:list": "bun corpus/list.ts",
    "corpus:snapshot": "bun corpus/snapshot.ts",
    "corpus:lint": "bun run build && bun corpus/lint.ts",
    "corpus:aggregate": "bun run build && bun corpus/aggregate.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p packages/browser/tsconfig.json && tsc --noEmit -p test/conformance/tsconfig.json",
    "validate:rules": "bun scripts/validate-rules.ts",
    "site:dev": "bun --filter @deadhead/site dev",
    "site:build": "bun run build && bun run build:css && bun run build:bookmarklet && bun --filter @deadhead/site build",
    "site:preview": "bun --filter @deadhead/site preview",
    "site:check": "bun --filter @deadhead/site check",
    "lint:deps": "e18e-cli analyze --log-level error --report-level warn"
  },
  "devDependencies": {
    "@e18e/cli": "0.7.0",
    "@html-eslint/parser": "^0.66.1",
    "@types/node": "^24.19.2",
    "eslint": "^10.12.0",
    "linkedom": "^0.18.13",
    "parse5": "^8.0.1",
    "publint": "^0.3.25",
    "rolldown": "^1.2.13",
    "rolldown-plugin-dts": "0.28.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "yaml": "^2.9.1"
  },
  "keywords": [
    "html",
    "head",
    "linter",
    "meta-tags",
    "deprecated",
    "eslint-plugin",
    "bookmarklet",
    "static-analysis"
  ],
  "workspaces": [
    "packages/*",
    "site"
  ],
  "overrides": {
    "fflate@0.7.3": "0.7.5",
    "minimatch@10.2.6": "11.0.4"
  },
  "trustedDependencies": []
}
