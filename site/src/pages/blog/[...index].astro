---
import Layout from "../../layouts/Layout.astro";
import { getPosts } from "../../lib/posts.ts";

// A rest route so that, with no post to list, there is no /blog at all.
export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.length === 0 ? [] : [{ params: { index: undefined }, props: { posts } }];
}

const { posts } = Astro.props;
const day = (date: Date) => date.toISOString().slice(0, 10);
---

<Layout title="Blog" description="Measurements of what the web ships in its head, with the data behind every number and a rule page behind every finding.">
  <link slot="head" rel="alternate" type="application/atom+xml" title="deadhead blog" href="/blog/feed.xml" />
  <h1>Blog</h1>
  <p class="lede">What the web ships in its head, measured, and what changes in deadhead.</p>
  <p>
    Measurement posts run deadhead over real pages, such as the home pages of the
    10,000 most visited sites, and publish the data behind every number: each
    figure is read from the data file when the page is built, and each rule named
    links to its page and sources. Release posts explain a new feature, what it
    checks and how to set it up.
  </p>
  <ul>
    {posts.map((post) => (
      <li>
        <a href={`/blog/${post.id}`}>{post.data.title}</a>, <time datetime={day(post.data.pubDate)}>{day(post.data.pubDate)}</time>
        <p>{post.data.description}</p>
      </li>
    ))}
  </ul>
  <p>New posts appear in the <a href="/blog/feed.xml">Atom feed</a>.</p>
</Layout>
