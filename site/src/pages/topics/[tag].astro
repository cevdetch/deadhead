---
import type { CollectionEntry } from "astro:content";
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import RuleGroup from "../../components/RuleGroup.astro";
import { groupRules } from "../../lib/group.ts";
import { tagBlurbs, tagLabels } from "../../vocabulary.ts";
import type { Tag } from "../../../../packages/core/vocabulary.ts";

// One page per tag some rule carries. A tag in TAGS that no rule uses yet has
// no page, rather than an empty one.
export async function getStaticPaths() {
  const byTag = groupRules(await getCollection("rules"), (rule) => rule.data.tags);
  return [...byTag].map(([tag, rules]) => ({ params: { tag }, props: { tag, rules } }));
}

const { tag, rules } = Astro.props as { tag: Tag; rules: CollectionEntry<"rules">[] };
---

<Layout title={`${tagLabels[tag]} HTML: ${rules.length} lint rules with sources`} description={tagBlurbs[tag]}>
  <RuleGroup back={{ href: "/topics", label: "topics" }} heading={tagLabels[tag]} blurb={tagBlurbs[tag]} rules={rules} />
</Layout>
