---
import { getCollection, render } from "astro:content";
import Layout, { REPO } from "../../layouts/Layout.astro";
import RuleFacts from "../../components/RuleFacts.astro";
import { ruleCoreTitle } from "../../lib/seo.ts";

// The route is `[...ruleId]` rather than `[ruleId]` because a ruleId contains a
// slash: `meta/keywords` is one id, not two segments. This URL is the contract
// `packages/core/vocabulary.ts` prints in every finding.
export async function getStaticPaths() {
  const rules = await getCollection("rules");
  return rules.map((rule) => ({
    params: { ruleId: rule.data.ruleId },
    props: { rule },
  }));
}

const { rule } = Astro.props;
const { Content } = await render(rule);
const { data } = rule;

const sourceUrl = `${REPO}/blob/main/content/rules/${data.ruleId}.md`;
const namespace = data.ruleId.split("/")[0]!;

// The visible breadcrumb, as structured data search results can show.
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Rules", item: new URL("/rules", Astro.site).href },
    { "@type": "ListItem", position: 2, name: `${namespace}/`, item: new URL(`/rules#${namespace}`, Astro.site).href },
    { "@type": "ListItem", position: 3, name: data.title },
  ],
};
---

<Layout
  title={ruleCoreTitle(data.title, data.severity, data.status)}
  description={data.description}
  ogType="article"
  publishedTime={data.pubDate}
  jsonLd={jsonLd}
>
  <article>
    <nav aria-label="Breadcrumb"><a href="/rules">Rules</a> / <a href={`/rules#${namespace}`}>{namespace}</a></nav>
    <h1>{data.title}</h1>
    <p class="lede">{data.description}</p>
    <aside>
      <h2>Instead</h2>
      <p>{data.replacement}</p>
    </aside>
    <RuleFacts rule={rule} sourceUrl={sourceUrl} />
    <Content />
  </article>
</Layout>
