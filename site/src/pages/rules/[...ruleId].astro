---
import { getCollection, render } from "astro:content";
import Layout, { REPO } from "../../layouts/Layout.astro";
import RuleFacts from "../../components/RuleFacts.astro";
import { ogImagePath } from "../../lib/og-path.ts";
import { ruleCoreTitle } from "../../lib/seo.ts";
import { articleNode, breadcrumbNode, graph } from "../../lib/structured-data.ts";
import { resourceUrls } from "../../lib/citations.ts";
import { modifiedDate, ruleCommitDates } from "../../lib/lastmod.ts";

// The route is `[...ruleId]` rather than `[ruleId]` because a ruleId contains a
// slash: `meta/keywords` is one id, not two segments. This URL is the contract
// `packages/core/vocabulary.ts` prints in every finding.
export async function getStaticPaths() {
  const rules = await getCollection("rules");
  // One git pass for all rule pages, not one per page.
  const committed = ruleCommitDates(process.cwd());
  return rules.map((rule) => ({
    params: { ruleId: rule.data.ruleId },
    props: { rule, modified: modifiedDate(rule.data.pubDate.toISOString().slice(0, 10), committed.get(rule.data.ruleId)) },
  }));
}

const { rule, modified } = Astro.props;
const { Content } = await render(rule);
const { data } = rule;

const sourceUrl = `${REPO}/blob/main/content/rules/${data.ruleId}.md`;
const namespace = data.ruleId.split("/")[0]!;

const path = `/rules/${data.ruleId}`;
const url = new URL(path, Astro.site).href;

// The rule as an article, plus the breadcrumb the page shows: Rules, the
// namespace, then the rule itself as the h1. `citation` carries the sources
// every rule is required to have; that is the site's point. datePublished is
// the rule's pubDate frontmatter; dateModified is the same date the sitemap
// and article:modified_time carry, from lib/lastmod.ts.
const jsonLd = graph(
  articleNode("TechArticle", {
    url,
    headline: data.title,
    description: data.description,
    datePublished: data.pubDate.toISOString(),
    dateModified: `${modified}T00:00:00.000Z`,
    image: new URL(ogImagePath(path), Astro.site).href,
    inLanguage: "en",
    site: new URL("/", Astro.site).href,
    citation: resourceUrls(rule.body ?? ""),
  }),
  breadcrumbNode(url, [
    { name: "Rules", url: new URL("/rules", Astro.site).href },
    { name: namespace, url: new URL(`/rules#${namespace}`, Astro.site).href },
    { name: data.title },
  ]),
);
---

<Layout
  title={ruleCoreTitle(data.title, data.severity, data.status)}
  description={data.description}
  ogType="article"
  publishedTime={data.pubDate}
  modifiedTime={new Date(`${modified}T00:00:00Z`)}
  jsonLd={jsonLd}
>
  <article>
    <nav aria-label="Breadcrumb"><a href="/rules">Rules</a> / <a href={`/rules#${namespace}`}>{namespace}</a></nav>
    <h1>{data.title}</h1>
    <p class="lede">{data.description}</p>
    <aside>
      <h2>Instead</h2>
      <p>{data.replacement}</p>
    </aside>
    <RuleFacts rule={rule} sourceUrl={sourceUrl} />
    <Content />
  </article>
</Layout>
