---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";

const ruleCount = (await getCollection("rules")).length;

// Runs automatically on first visit, like shared links and bookmarklet handoffs.
const example = `<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1, user-scalable=no">
    <title>Example</title>
    <meta name="keywords" content="html, head, linter">
    <link rel="shortcut icon" href="/favicon.ico">
    <script type="text/javascript" src="/app.js"></script>
  </head>
  <body></body>
</html>`;
---

<Layout
  title="Lint your HTML in the browser"
  description="Paste HTML or open a file to read deadhead findings and explanations, then copy HTML after automatic fixes. Runs in your browser."
>
  <style slot="head" is:inline>
    #try-input,#try-output{width:100%;padding:.8rem 1rem;border:1px solid var(--line);border-radius:6px;background:var(--sunk);color:inherit;font:var(--small)/1.55 var(--mono);resize:vertical}
    #try-input{min-height:18rem}
    #try-report{min-height:100svh}
    .try-row{display:flex;flex-wrap:wrap;gap:.6rem;align-items:center;margin-block-start:.6rem}
    .try-row small,#try-from{color:var(--muted);margin-inline-start:auto;overflow-wrap:anywhere}
    #try-form button,#try-file::file-selector-button,#try-fixed summary{font:inherit;font-size:var(--small);padding:.45rem .9rem;border:1px solid var(--line);border-radius:6px;background:var(--sunk);color:var(--text);cursor:pointer}
    #try-form [type=submit]{background:var(--accent);border-color:var(--accent);color:var(--bg);font-weight:600}
    #try-file{font-size:var(--small);color:var(--muted)}
    #try-status{padding:.6rem 1rem;border-radius:6px;background:var(--accent-bg)}
    #try-status:empty{display:none}
    #try-status span,.rules li>span{font-size:.75rem;border:1px solid currentColor;border-radius:3px;padding:.05rem .45rem;margin-inline-start:.4rem;white-space:nowrap}
    .rules pre{grid-column:1/-1;margin:0}
    .rules li>p:first-of-type{color:var(--text)}
    #try-results p code{white-space:nowrap}
    #try-fixed summary{display:inline-block}
  </style>
  <h1>Try deadhead</h1>
  <p class="lede">
    Paste HTML or open a file. Your HTML stays in your browser.
  </p>
  <form id="try-form">
    <label for="try-input">HTML</label>
    <textarea id="try-input" spellcheck="false">{example}</textarea>
    <div class="try-row">
      <button type="submit">Lint</button>
      <input id="try-file" type="file" accept=".html,.htm,text/html" aria-label="Open an HTML file" />
      <button id="try-share" type="button">Copy link</button>
      <small><kbd>Ctrl</kbd> + <kbd>Enter</kbd> lints</small>
    </div>
  </form>
  <p><small>Share links hold up to 16,000 characters of compressed HTML. Open larger files directly.</small></p>
  <noscript><p>The linter runs in your browser and needs JavaScript. The CLI does the same offline: see <a href="/install">Install</a>.</p></noscript>
  <section id="try-report" aria-label="Lint report">
    <p id="try-from" hidden></p>
    <p id="try-status" role="status"></p>
    <section id="try-results" aria-live="polite"></section>
    <details id="try-fixed" hidden>
      <summary>HTML after automatic fixes</summary>
      <textarea id="try-output" readonly rows="16" spellcheck="false"></textarea>
      <p><button id="try-copy" type="button">Copy HTML</button></p>
    </details>
  </section>

  <h2>What it checks</h2>
  <p>
    This page runs the CLI's own lint path in your browser: the same HTML parser
    and all {ruleCount} rules at their default settings. A finding here is one{" "}
    <code>npx deadhead</code> reports for the same file. Each lists the rule, the
    line and column, the severity, the markup found and what to write instead,
    and the rule id links to the page that explains it, with sources.
  </p>
  <p>
    HTML with a doctype or an <code>&lt;html&gt;</code> tag is checked as a page.
    Anything else is a fragment, such as a layout partial, and is checked for the
    markup it holds, never for head content it lacks.
  </p>

  <h2>How to use it</h2>
  <ul>
    <li>
      Paste HTML and press Lint, or <kbd>Ctrl</kbd> + <kbd>Enter</kbd>{" "}
      (<kbd>⌘</kbd> + <kbd>Enter</kbd> on a Mac). The example above runs on your
      first visit.
    </li>
    <li>Open a file to load it and lint it in one step.</li>
    <li>
      Findings marked "Automatic fix" are removed in{" "}
      <em>HTML after automatic fixes</em>, which holds the file as{" "}
      <code>deadhead --fix</code> would write it.
    </li>
    <li>
      Copy link compresses the HTML into the address and copies it. Whoever opens
      the link gets the same report.
    </li>
    <li>
      The <a href="/install#bookmarklet">bookmarklet</a>'s full report button
      opens this page with the page you were on: its HTML as the server sent it,
      or the rendered DOM when that copy cannot be read.
    </li>
  </ul>

  <h2>Your HTML stays in your browser</h2>
  <p>
    The linter and its rules load with this page, and linting runs on your
    machine. Nothing you paste is uploaded or stored. A share link carries the
    HTML after the <code>#</code>, in the fragment, which browsers do not send to
    servers, and the bookmarklet hands a page over the same way. The HTML leaves
    your machine only when you send someone the link.
  </p>
  <p>
    To check a whole site, in CI or as you develop, <a href="/install">install the
    CLI or the Vite plugin</a>. Browse what it checks{" "}
    <a href="/rules">by namespace</a> or <a href="/topics">by topic</a>.
  </p>
</Layout>

<script>
  import "../scripts/try.ts";
</script>
