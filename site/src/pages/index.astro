---
import { getCollection } from "astro:content";
import Layout, { REPO } from "../layouts/Layout.astro";
import RuleList from "../components/RuleList.astro";
import { AUTHOR, SITE_NAME } from "../lib/seo.ts";
import { namespaceBlurbs } from "../vocabulary.ts";

const rules = await getCollection("rules");
const count = (severity: string) => rules.filter((r) => r.data.severity === severity).length;
const newest = [...rules]
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf() || a.data.ruleId.localeCompare(b.data.ruleId))
  .slice(0, 8);

// Namespaces in the order the rules index lists them, with their counts.
const namespaces = [...new Set(rules.map((r) => r.data.ruleId.split("/")[0]!))]
  .sort()
  .map((namespace) => ({
    namespace,
    count: rules.filter((r) => r.data.ruleId.startsWith(`${namespace}/`)).length,
    blurb: namespaceBlurbs[namespace] ?? "",
  }));

const sample = `$ npx deadhead dist

dist/index.html
  5:5  unnecessary  meta/revisit-after
       A crawl-schedule hint that search engines ignore;
       recrawl timing comes from sitemaps, not markup.
       → Delete the element and publish change timing in an XML sitemap.
       https://deadhead.cevdet.ch/rules/meta/revisit-after

✖ 1 finding (1 unnecessary)`;

const description =
  "A documentation-driven linter for the HTML head: it finds deprecated, unnecessary and harmful markup, and every finding links to a sourced explanation.";

// The site name Google shows in results comes from a WebSite node on the
// home page. No SearchAction: meta/json-ld-search-action reports it.
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: SITE_NAME,
  url: new URL("/", Astro.site).href,
  description,
  inLanguage: "en",
  publisher: { "@type": "Person", name: AUTHOR.name, url: AUTHOR.url },
};
---

<Layout
  title="deadhead: lint the HTML head for dead and harmful markup"
  description={description}
  jsonLd={jsonLd}
>
    <h1>Lint the HTML head for dead, deprecated and harmful markup</h1>
    <p class="lede">
      Deadheading is cutting the spent growth off a plant. This does that to
      your <code>&lt;head&gt;</code>: it finds markup that is harmful,
      deprecated or dead weight, and every finding links to a written
      explanation of why, with sources.
    </p>

    <pre><samp>{sample}</samp></pre>

    <h2>Why another linter</h2>
    <p>
      Most tools tell you <em>that</em> something is wrong. Head markup needs{" "}
      <em>why</em>: whether the advice you read in 2014 still holds. Every rule
      here is a markdown document carrying at
      least two independent sources, and the linter is generated from those
      documents. A rule that cannot be explained does not ship.
    </p>
    <p>
      Severity says what the finding costs you, not how loudly the tool wants to
      say it:{" "}
      <strong>harmful</strong> breaks something for users,{" "}
      <strong>deprecated</strong> is formally obsolete but inert,{" "}
      <strong>unnecessary</strong> works but is dead weight.
    </p>

    <h2>Three runtimes, one rule set</h2>
    <section>
      <h3>CLI</h3>
      <p>
        Walks files and directories, and expands globs itself. Stylish, JSON and
        SARIF output, so
        CI annotates the diff. Exit codes are the contract.
      </p>
    </section>
    <section>
      <h3>Bookmarklet</h3>
      <p>
        One IIFE with the rules inlined and no <code>fetch</code>, so a strict
        CSP cannot block it. It inspects rendered output, which is ground
        truth.
      </p>
    </section>
    <section>
      <h3>ESLint plugin</h3>
      <p>
        The same findings inside <code>eslint</code>, with autofix, because a
        fix is a text edit over a byte range either way.
      </p>
    </section>
    <p>
      A conformance suite runs every fixture through all three and asserts
      identical findings. That is what stops them
      drifting.
    </p>

    <h2>What it catches</h2>
    <dl>
      {namespaces.map(({ namespace, count, blurb }) => (
        <div>
          <dt><a href={`/rules#${namespace}`}><code>{namespace}/</code></a></dt>
          <dd>{blurb}<small>{count} rules</small></dd>
        </div>
      ))}
    </dl>

    <h2>The rules</h2>
    <p>
      {rules.length} rules: {count("harmful")} harmful, {count("deprecated")} deprecated,{" "}
      {count("unnecessary")} unnecessary.{" "}
      <a href="/rules">Browse them by namespace</a>, <a href="/topics">by topic</a> or{" "}
      <a href="/impacts">by impact</a>.
    </p>
    <h3>Newest</h3>
    <RuleList rules={newest} />

    <h2>Get it</h2>
    <p>
      <a href="/install">Installation and usage</a>, or read the{" "}
      <a href={REPO}>source on GitHub</a>.
    </p>
</Layout>
