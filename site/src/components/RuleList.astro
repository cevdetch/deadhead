---
import type { CollectionEntry } from "astro:content";
import { severityLabels } from "../vocabulary.ts";

interface Props {
  rules: CollectionEntry<"rules">[];
}

const { rules } = Astro.props;
---

<ul class="rules">
  {rules.map((rule) => (
    <li>
      <a href={`/rules/${rule.data.ruleId}`}><code>{rule.data.ruleId}</code></a>{" "}
      <span data-severity={rule.data.severity}>{severityLabels[rule.data.severity]}</span>
      <p>{rule.data.description}</p>
    </li>
  ))}
</ul>
